extends "res://tests/free_escort_selection_input_test.gd"
## Normal production _process throughout; complete Viewport gestures, not direct
## placement/selection calls. Controlled shop stock only sets edge-case fixtures.
func snapshot() -> Array:
	return [game.coins,game.population,game.heroes.size(),game._deployed_count()]

func run():
	game = load("res://scenes/free_escort.tscn").instantiate()
	root.add_child(game)
	current_scene = game
	game.audio_feedback.enabled = false
	await frames()
	check(game.is_processing() and not game.bench_open and not game.bench_panels[0].visible and game.bench_toggle.is_visible_in_tree(),"normal frames; bench hidden by default with reachable button")
	await press(KEY_SPACE)
	var before := snapshot()
	for key in [KEY_1,KEY_2,KEY_3,KEY_Q,KEY_W,KEY_E]: await press(key)
	check(snapshot()==before and game.selected_hero==null,"numbers never purchase with shop open; empty skills never spend")
	for card in game.shop_buttons: await click(card.get_global_rect().get_center())
	check(game.coins==0 and game.heroes.size()==3 and not game.heroes[0].visible,"mouse buying stores hidden bench inventory")
	await press(KEY_SPACE)
	await click(game.bench_toggle.get_global_rect().get_center())
	check(game.bench_open and game.bench_panels[7].visible and game.heroes[0].visible,"button opens full eight-seat bench")
	var hero = game.heroes[0]
	var bench_at: Vector2 = hero.position
	await click(bench_at)
	check(game.carry_hero==hero and hero.bench_slot==0 and hero.position==bench_at and game._deployed_count()==0,"first release holds preview only, inventory unchanged")
	await pointer(Vector2(1000,470),"motion")
	check(game.carry_preview.position==Vector2(1000,470) and hero.position==bench_at,"preview follows pointer; source remains in inventory")
	await click(Vector2(1000,470))
	check(game.carry_hero==hero and game._deployed_count()==0 and "无法部署" in game.status_label.text,"invalid second click retains preview and explains rejection")
	before = snapshot()
	await click(Vector2(1000,470),MOUSE_BUTTON_RIGHT)
	check(game.carry_hero==null and game.carry_preview==null and hero.bench_slot==0 and hero.position==bench_at and snapshot()==before and "已取消拿起" in game.status_label.text,"right click cancels rejected pickup without inventory or gold changes")
	await click(game.escort.position+Vector2(60,-25))
	await click(Vector2(1000,470),MOUSE_BUTTON_RIGHT)
	check(snapshot()==before and hero.position==bench_at,"cancelled pickup stays cancelled on later ground click or repeated right click")
	await click(bench_at)
	await press(KEY_SPACE)
	await click(game.shop_buttons[0].get_global_rect().get_center(),MOUSE_BUTTON_RIGHT)
	check(game.carry_hero==null and game.carry_preview==null and snapshot()==before and hero.position==bench_at,"right click over shop UI cancels without purchase or placement")
	await press(KEY_SPACE)
	await pointer(bench_at,"press")
	await pointer(game.escort.position+Vector2(60,-25),"motion")
	var cancel := InputEventMouseButton.new()
	cancel.position = game.escort.position+Vector2(60,-25)
	cancel.button_index = MOUSE_BUTTON_RIGHT
	cancel.pressed = true
	cancel.button_mask = MOUSE_BUTTON_MASK_LEFT | MOUSE_BUTTON_MASK_RIGHT
	root.push_input(cancel,true)
	await frames()
	cancel = cancel.duplicate()
	cancel.pressed = false
	cancel.button_mask = MOUSE_BUTTON_MASK_LEFT
	root.push_input(cancel,true)
	await pointer(game.escort.position+Vector2(60,-25),"release")
	check(game.carry_hero==null and not game.carry_pressed and snapshot()==before and hero.position==bench_at,"right click during held drag prevents later left release from deploying")
	await click(bench_at)
	await press(KEY_ESCAPE)
	check(game.carry_hero==null and hero.position==bench_at and game.heroes.size()==3,"Escape cancels without inventory change")
	await click(bench_at)
	await press(KEY_B)
	check(not game.bench_open and game.carry_hero==null and not hero.visible,"B closes and cancels")
	await press(KEY_B)
	await click(bench_at)
	await press(KEY_9)
	check(game.carry_hero==null and hero.bench_slot==0 and game.selected_hero==null,"empty numbered slot safely cancels pickup")
	await click(bench_at)
	var first: Vector2 = game.escort.position+Vector2(60,-25)
	await click(first)
	check(hero.position==first and hero.bench_slot==-1 and game.carry_hero==null and game._deployed_count()==1,"second legal click commits once")
	var other = game.heroes[1]
	var second: Vector2 = game.escort.position+Vector2(110,-25)
	await pointer(other.position,"motion")
	await pointer(other.position,"press")
	await pointer(second,"motion")
	check(other.board_row<0 and game._deployed_count()==1,"drag only previews until release")
	await pointer(second,"release")
	check(other.position==second and game.carry_hero==null and game._deployed_count()==2,"drag release commits exactly once")
	var healer = game.heroes[2]
	await click(healer.position)
	await press(KEY_SPACE)
	await click(game.shop_controls[0].get_global_rect().get_center())
	check(game.carry_hero==healer and healer.board_row<0 and game._deployed_count()==2,"shop background consumes click, no placement through UI")
	await press(KEY_2)
	check(game.selected_hero==other and game.carry_hero==null and healer.board_row<0,"number selects stable deployed hero even with shop open")
	await press(KEY_SPACE)
	await click(healer.position)
	var third: Vector2 = game.escort.position+Vector2(160,-25)
	await click(third)
	await shot("free-roster-deployed")
	# Controlled extra stock exercises population and source mutation safety.
	game.coins = 10
	game.shop_types.assign(["foxfire_imp","foxfire_imp","foxfire_imp"])
	await press(KEY_SPACE)
	await click(game.shop_buttons[0].get_global_rect().get_center())
	await press(KEY_SPACE)
	var fox = game.heroes.back()
	await click(fox.position)
	await click(game.escort.position+Vector2(80,50))
	check(game.carry_hero==fox and fox.board_row<0 and game._deployed_count()==3 and "人口已满" in game.status_label.text,"click deployment enforces population and retains preview")
	await press(KEY_ESCAPE)
	await pointer(fox.position,"motion")
	await pointer(fox.position,"press")
	await pointer(game.escort.position+Vector2(80,50),"motion")
	await pointer(game.escort.position+Vector2(80,50),"release")
	check(game.carry_hero==fox and fox.board_row<0 and game._deployed_count()==3,"drag and click enforce the same population rule")
	await press(KEY_SPACE)
	await click(game.shop_buttons[1].get_global_rect().get_center())
	await click(game.shop_buttons[2].get_global_rect().get_center())
	check(fox.star==2 and game.carry_hero==null and game.heroes.size()==4,"merge of preview source cancels safely, no duplicated actor")
	await press(KEY_SPACE)
	await click(fox.position)
	await click(game.sell_button.get_global_rect().get_center())
	check(game.carry_hero==null and game.heroes.size()==3,"selling picked source clears preview")
	before = snapshot()
	await press(KEY_E)
	check(snapshot()==before and game.coins>=4,"E does not upgrade even with sufficient gold in preparation")
	await click(game.level_button.get_global_rect().get_center())
	check(game.population==4 and game.coins==int(before[0])-4,"mouse population upgrade remains available at original price")
	# Stable holes: bench first hero, slots two and three must not shift.
	await pointer(hero.position,"motion")
	await pointer(hero.position,"press")
	await pointer(game._bench_position(0),"motion")
	await pointer(game._bench_position(0),"release")
	await press(KEY_1)
	check(game.selected_hero==null,"retired slot is empty, not next hero")
	await press(KEY_2)
	check(game.selected_hero==other,"surviving hero keeps slot two")
	await click(hero.position)
	await click(first)
	await press(KEY_1)
	check(game.selected_hero==hero,"next deployment reuses first empty slot")
	# Text focus and key echo are tested through real GUI routing.
	var edit := LineEdit.new()
	edit.position = Vector2(320,830)
	edit.size = Vector2(400,32)
	edit.z_index = 2100
	game.add_child(edit)
	edit.grab_focus()
	before = snapshot()
	await press(KEY_2)
	await press(KEY_E)
	await press(KEY_B)
	check(game.selected_hero==hero and snapshot()==before and game.bench_open,"text input focus does not steal gameplay hotkeys")
	edit.release_focus()
	edit.queue_free()
	var echo_key := InputEventKey.new()
	echo_key.keycode = KEY_B
	echo_key.pressed = true
	echo_key.echo = true
	Input.parse_input_event(echo_key)
	await frames()
	check(game.bench_open,"repeated key event does not toggle bench")
	await click(game.start_button.get_global_rect().get_center())
	game.intermission = 999
	await press(KEY_P)
	check(game.battle_paused and not game.bench_open and game.carry_hero==null,"departure clears preview and closes bench")
	await press(KEY_2)
	var goal: Vector2 = other.position+Vector2(0,-70)
	await click(goal,MOUSE_BUTTON_RIGHT)
	check(game.selected_hero==other and game._brain(other).goal==goal,"number selection then right click commands selected hero")
	var frozen: Vector2 = other.position
	before = snapshot()
	for key in [KEY_Q,KEY_W,KEY_E]: await press(key)
	check(snapshot()==before and game._brain(other).goal==goal and other.position==frozen and game.combat.strikes.is_empty(),"reserved skills do not move, attack, consume or replace command")
	await press(KEY_9)
	await click(first+Vector2(0,-70),MOUSE_BUTTON_RIGHT)
	check(game.selected_hero==null and game._brain(other).goal==goal,"empty selection right click never commands previous hero")
	hero.take_damage(9999)
	await press(KEY_1)
	check(game.selected_hero==null,"dead numbered hero cannot be selected")
	await press(KEY_2)
	check(game.selected_hero==other,"death does not renumber survivors")
	await shot("free-roster-paused-order")
	game._enter_wave_preparation()
	await frames()
	check(not game.bench_open and game.carry_hero==null,"camp begins with closed bench and no stale preview")
	game._restart_demo()
	await frames()
	check(not game.bench_open and game.hero_slots.is_empty() and game.coins==3,"restart resets roster interaction")
	# Ten-slot setup is controlled test stock/population, not an earned army.
	game.coins = 30
	game.population = 10
	for i in range(10):
		game.shop_types[0] = game.DemoUnits.SHOP[i%5]
		game._on_shop_pressed(0)
		var unit = game.heroes.back()
		unit.merge_locked = true
		var point: Vector2 = game._near_free(game.escort.position+Vector2(70,0),unit,200)
		check(point!=Vector2.INF and game._place_free(unit,point),"ten-slot fixture deploy %d" % i)
	for i in range(10):
		await press(KEY_0 if i==9 else KEY_1+i)
		check(game.selected_hero==game.heroes[i],"native stable number selects slot %d" % (i+1))
	game.shop_types[0] = "guard_monk"
	game._on_shop_pressed(0)
	var reserve = game.heroes.back()
	await press(KEY_B)
	await click(reserve.position)
	check(game.carry_hero==reserve,"phase fixture has live pickup")
	await click(game.start_button.get_global_rect().get_center())
	game.intermission = 999
	await press(KEY_P)
	check(game.carry_hero==null and not game.bench_open,"departure with picked inventory cancels preview")
	await press(KEY_B)
	var deployed: int = game._deployed_count()
	await click(reserve.position)
	await click(game.escort.position+Vector2(-80,0))
	check(game.carry_hero==null and reserve.board_row<0 and game._deployed_count()==deployed,"battle-open bench is read-only, cannot deploy")
	game._enter_wave_preparation()
	await frames()
	await press(KEY_B)
	await click(reserve.position)
	check(game.carry_hero==reserve,"removed-source fixture picked")
	# Simulate a source consumed by merge rather than keeper upgrade.
	game.heroes.erase(reserve)
	reserve.queue_free()
	await frames()
	check(game.carry_hero==null,"removed/freed source cancels preview without dangling reference")
	print("FREE_ROSTER_INPUT failures=",failures)
	game.free()
	quit(1 if failures else 0)
