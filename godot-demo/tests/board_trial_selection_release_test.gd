extends "res://tests/board_trial_input_test.gd"

func cleared(label: String) -> void:
	check(game.selected.is_empty() and not game.pointer_drag and game.pointer_origin==Vector2.ZERO and game.range_cells().is_empty(),label+" clears selection/drag/origin/range")
	check(not game.ui.selected_portrait.visible and not game.withdraw_button.visible,label+" removes detail selection and withdraw control")
	for card in game.roster_buttons:
		check(card.get_theme_stylebox("normal").border_color==game.Style.EDGE,label+" clears all SELECTED gold card borders, not ordinary hover")

func reset() -> void:
	await click(game.formation_buttons[0].get_global_rect().get_center())
	await frames()

func drag(from: Vector2i, to: Vector2) -> void:
	await pointer(game.display_center(from),true)
	await settle(to)
	await pointer(to,false)

func run() -> void:
	root.size = Vector2i(1280,720)
	game = load("res://scenes/board_trial.tscn").instantiate()
	root.add_child(game)
	current_scene = game
	game.audio_feedback.enabled = false
	await frames()
	check(game.get_script().resource_path=="res://scripts/board_depth.gd","selection release test loads the main depth controller")
	var a: Vector2i = game.deployment.tangseng
	var b: Vector2i = game.deployment.guard_monk
	# A pure press/release on A is selection, never a same-cell placement.
	await click(game.display_center(a))
	check(game.selected=="tangseng" and not game.pointer_drag and not game.range_cells().is_empty(),"pure board click retains inspection and range")
	await pointer(game.display_center(Vector2i(0,0)),true)
	check(game.deployment.tangseng==Vector2i(0,0),"empty-cell placement commits at press")
	cleared("press commit")
	var committed: Dictionary = game.deployment.duplicate()
	await settle(game.display_center(Vector2i(1,0)))
	await pointer(game.display_center(Vector2i(1,0)),false)
	check(game.deployment==committed,"same release never places twice or selects occupant")
	cleared("complete gesture")
	await click(game.display_center(Vector2i(1,0)))
	check(game.deployment==committed and game.selected.is_empty(),"later empty ground cannot control unselected A")
	await reset()
	await click(game.roster_buttons[0].get_global_rect().get_center())
	await pointer(game.display_center(b),true)
	check(game.deployment.tangseng==b and game.deployment.guard_monk==a and game.deployment.size()==6,"swap press conserves both positions/all six actors")
	cleared("swap press")
	committed = game.deployment.duplicate()
	await pointer(game.display_center(b),false)
	check(game.deployment==committed,"swap release cannot swap back or select B")
	cleared("swap release")
	await click(game.display_center(Vector2i(0,0)))
	check(game.deployment==committed,"ground after swap cannot move A or B")
	await reset()
	await press(KEY_2)
	check(game.selected=="guard_monk","numeric selection still retained before placement")
	await click(game.display_center(Vector2i(0,6)))
	check(game.deployment.guard_monk==Vector2i(0,6),"numeric-selected actor places normally")
	cleared("numeric place")
	await reset()
	await click(game.roster_buttons[5].get_global_rect().get_center())
	await press(KEY_R)
	check(game.selected=="foxfire_imp" and not game.deployment.has("foxfire_imp"),"R keeps its existing selected inventory semantics")
	var before: Dictionary = game.deployment.duplicate()
	await click(game.display_center(a))
	check(game.selected=="foxfire_imp" and game.deployment==before,"inventory-to-occupied swap fails, preserves actor/selection")
	await click(game.display_center(Vector2i(0,0)))
	check(game.deployment.foxfire_imp==Vector2i(0,0) and game.deployment.size()==6,"inventory card places without duplicate/loss")
	cleared("inventory place")
	await reset()
	await drag(a,game.display_center(Vector2i(0,0)))
	check(game.deployment.tangseng==Vector2i(0,0),"successful complete drag changes one endpoint")
	cleared("drag success")
	await reset()
	await drag(a,game.display_center(b))
	check(game.deployment.tangseng==b and game.deployment.guard_monk==a,"drag-to-friend swaps both endpoints only once")
	cleared("drag swap")
	await reset()
	await drag(a,game.display_center(a)+Vector2(12,0))
	check(game.deployment.tangseng==a,"accepted drag within original cell preserves position")
	cleared("accepted same-cell drag")
	await reset()
	before = game.deployment.duplicate()
	await drag(a,game.display_center(Vector2i(6,3)))
	check(game.selected=="tangseng" and game.deployment==before and not game.pointer_drag and not game.range_cells().is_empty(),"right-half failed drag preserves A/data/range but ends gesture")
	var corner: Vector2=game.display_center(Vector2i.ZERO)
	var grid_axes: Vector2=game.display_center(Vector2i.RIGHT)+game.display_center(Vector2i.DOWN)-corner*2
	var outside: Vector2=corner-grid_axes*0.51
	check(game.display_cell_at(outside)==Vector2i(-1,-1),"failed-drag fixture is outside the projected top-left board boundary")
	await drag(a,outside)
	check(game.selected=="tangseng" and game.deployment==before and not game.pointer_drag,"off-board failed drag preserves A/data and clears stale gesture")
	await pointer(game.display_center(Vector2i(0,0)),false)
	check(game.deployment==before,"stray release after failed drag cannot accidentally place A")
	await click(game.display_center(Vector2i(6,3)))
	check(game.selected=="tangseng" and game.deployment==before,"invalid click also retains selected A")
	await click(Vector2(960,500),MOUSE_BUTTON_RIGHT)
	check(game.selected.is_empty(),"ordinary right cancel still available")
	await click(game.ui.enemy_buttons[0].get_global_rect().get_center())
	check(game.selected=="E1","enemy inspection retains selection")
	await click(game.display_center(Vector2i(0,0)))
	check(game.selected=="E1" and game.deployment==before,"enemy cannot place or lose inspection through failed placement")
	await click(game.roster_buttons[0].get_global_rect().get_center())
	await click(game.ui.help_button.get_global_rect().get_center())
	await click(game.display_center(Vector2i(0,0)))
	await click(Vector2(960,500),MOUSE_BUTTON_RIGHT)
	check(game.selected=="tangseng" and game.deployment==before,"help preserves underlying control, never falsely commits")
	await click(game.ui.help_close.get_global_rect().get_center())
	await click(game.start_button.get_global_rect().get_center())
	await press(KEY_P)
	await click(game.roster_buttons[0].get_global_rect().get_center())
	var time: float = game.elapsed
	await click(game.display_center(Vector2i(0,0)))
	await press(KEY_R)
	check(game.selected=="tangseng" and game.deployment==before and game.elapsed==time and game.paused,"paused battle rejection does not run success-release logic")
	# Data API remains selection-neutral for simulations and fixtures.
	await click(game.retry_button.get_global_rect().get_center())
	game.select("tangseng")
	check(game.place("tangseng",Vector2i(0,0)) and game.selected=="tangseng","direct data place is not polluted by UI release")
	print("BOARD_SELECTION_RELEASE failures=",failures)
	game.free()
	quit(1 if failures else 0)
